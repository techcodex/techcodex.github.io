# Required — ngrok no longer allows anonymous tunnels, even ephemeral ones.
# Get a free token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Only used if you switch the ngrok compose command to the --domain form (see docker-compose.yml).
NGROK_DOMAIN=

# Public URL of the chatbot Worker (see worker/README.md). Not a secret —
# it's baked into the client bundle, same as any VITE_ var. Leave unset to
# disable the chat widget's backend calls (it'll show a connection error).
VITE_CHAT_API_URL=
